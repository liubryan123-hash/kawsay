{
  "name": "kawsay-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KAWSAY rule engine, triage/evaluation screens and metrics (KUNTUR X, NASA Space Apps 2026)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-data": "tsx scripts/check-data.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "demo": "node scripts/build-demo.mjs",
    "import-workbook": "tsx scripts/import-workbook.ts",
    "serve-demo": "node scripts/serve-demo.mjs",
    "test:checkin-smoke": "node scripts/checkin-smoke.mjs",
    "demo:simulador": "node scripts/build-simulator.mjs",
    "serve:simulador": "node scripts/serve-demo.mjs --simulador",
    "test:simulador": "node scripts/build-simulator.mjs && node --test simulator/*.test.mjs",
    "test:simulador-ui": "node scripts/build-simulator.mjs && node simulator/ui-smoke.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.21.0",
    "exceljs": "^4.4.0",
    "jsdom": "^24.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
